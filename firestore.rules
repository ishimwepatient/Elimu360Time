rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    // Lesson Plans collection
    match /lesson_plans/{planId} {
      // Anyone can read lesson plans (free open system)
      allow read: if true;

      // Anyone (authenticated or guest) can create lesson plans
      allow create: if true;

      // Owner or authenticated user can update or delete their lesson plans
      allow update, delete: if isSignedIn() 
        && (resource.data.user_id == request.auth.uid || !('user_id' in resource.data) || resource.data.user_id == '');
    }
  }
}
