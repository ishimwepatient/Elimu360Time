{
  "entities": {
    "schools": {
      "title": "Schools",
      "description": "Educational institutions registered in the multi-tenant SIMS.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "curriculum_type": { "type": "string", "enum": ["REB", "CAMBRIDGE", "IB"] },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "contact_email": { "type": "string" },
        "phone": { "type": "string" },
        "motto": { "type": "string" },
        "logo_url": { "type": "string" },
        "active_academic_year": { "type": "string" },
        "active_term": { "type": "string" },
        "currency": { "type": "string" },
        "is_active": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "name", "code", "curriculum_type", "is_active"]
    },
    "users": {
      "title": "Users",
      "description": "System accounts including Super Admin, Director, DOS, Bursar, Teachers, Librarians, Parents, and Students.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["SUPER_ADMIN", "SCHOOL_ADMIN", "DOS", "TEACHER", "BURSAR", "LIBRARIAN", "PARENT", "STUDENT"] 
        },
        "school_id": { "type": "string" },
        "avatar_url": { "type": "string" },
        "phone": { "type": "string" },
        "national_id": { "type": "string" },
        "subject_names": { "type": "array", "items": { "type": "string" } },
        "assigned_class_id": { "type": "string" },
        "linked_student_ids": { "type": "array", "items": { "type": "string" } },
        "title": { "type": "string" },
        "is_claimed": { "type": "boolean" },
        "activation_token": { "type": "string" },
        "password_hash": { "type": "string" },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "students": {
      "title": "Students",
      "description": "Enrolled student records.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "registration_number": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE"] },
        "date_of_birth": { "type": "string" },
        "class_id": { "type": "string" },
        "class_name": { "type": "string" },
        "enrollment_date": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "GRADUATED", "SUSPENDED", "TRANSFERRED"] },
        "guardian_name": { "type": "string" },
        "guardian_phone": { "type": "string" },
        "guardian_email": { "type": "string" },
        "guardian_relation": { "type": "string" },
        "address": { "type": "string" },
        "medical_notes": { "type": "string" },
        "photo_url": { "type": "string" },
        "boarding_status": { "type": "string", "enum": ["DAY", "BOARDING"] }
      },
      "required": ["id", "school_id", "registration_number", "first_name", "last_name", "class_id", "status"]
    },
    "classes": {
      "title": "Classrooms",
      "description": "Grade levels and streams.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "stream": { "type": "string" },
        "capacity": { "type": "number" },
        "class_teacher_id": { "type": "string" },
        "class_teacher_name": { "type": "string" },
        "room_number": { "type": "string" }
      },
      "required": ["id", "school_id", "name", "level", "stream"]
    },
    "subjects": {
      "title": "Subjects",
      "description": "Academic subjects offered.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "department": { "type": "string" },
        "credits": { "type": "number" },
        "pass_mark": { "type": "number" }
      },
      "required": ["id", "school_id", "name", "code"]
    },
    "timetables": {
      "title": "Timetable Slots",
      "description": "Weekly scheduling slots.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "class_id": { "type": "string" },
        "class_name": { "type": "string" },
        "subject_id": { "type": "string" },
        "subject_name": { "type": "string" },
        "teacher_id": { "type": "string" },
        "teacher_name": { "type": "string" },
        "room": { "type": "string" },
        "day_of_week": { "type": "string" },
        "start_time": { "type": "string" },
        "end_time": { "type": "string" },
        "term": { "type": "string" }
      },
      "required": ["id", "school_id", "class_id", "subject_id", "teacher_id", "day_of_week", "start_time", "end_time"]
    },
    "grades": {
      "title": "Grades",
      "description": "Student academic marks.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "student_id": { "type": "string" },
        "student_name": { "type": "string" },
        "subject_id": { "type": "string" },
        "subject_name": { "type": "string" },
        "class_id": { "type": "string" },
        "term": { "type": "string" },
        "academic_year": { "type": "string" },
        "assessment_type": { "type": "string", "enum": ["CAT", "MID_TERM", "END_OF_TERM"] },
        "marks": { "type": "number" },
        "max_marks": { "type": "number" },
        "teacher_id": { "type": "string" },
        "teacher_name": { "type": "string" },
        "entered_at": { "type": "string" },
        "remarks": { "type": "string" }
      },
      "required": ["id", "school_id", "student_id", "subject_id", "assessment_type", "marks", "max_marks"]
    },
    "attendance": {
      "title": "Attendance",
      "description": "Daily or subject attendance records.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "student_id": { "type": "string" },
        "student_name": { "type": "string" },
        "class_id": { "type": "string" },
        "class_name": { "type": "string" },
        "subject_id": { "type": "string" },
        "subject_name": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["PRESENT", "ABSENT", "LATE", "EXCUSED"] },
        "marked_by_id": { "type": "string" },
        "marked_by_name": { "type": "string" },
        "marked_at": { "type": "string" }
      },
      "required": ["id", "school_id", "student_id", "date", "status"]
    },
    "fee_structures": {
      "title": "Fee Structures",
      "description": "Tuition and operational fees scheduled per level.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "academic_year": { "type": "string" },
        "term": { "type": "string" },
        "class_level": { "type": "string" },
        "category": { "type": "string" },
        "category_label": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "due_date": { "type": "string" },
        "mandatory": { "type": "boolean" }
      },
      "required": ["id", "school_id", "category", "amount", "term"]
    },
    "payments": {
      "title": "Fee Payments",
      "description": "Student fee collection transactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "receipt_number": { "type": "string" },
        "student_id": { "type": "string" },
        "student_name": { "type": "string" },
        "student_reg": { "type": "string" },
        "class_name": { "type": "string" },
        "fee_category": { "type": "string" },
        "amount_paid": { "type": "number" },
        "payment_date": { "type": "string" },
        "payment_method": { "type": "string" },
        "transaction_reference": { "type": "string" },
        "bursar_id": { "type": "string" },
        "bursar_name": { "type": "string" },
        "payer_name": { "type": "string" },
        "term": { "type": "string" },
        "academic_year": { "type": "string" },
        "remarks": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "school_id", "receipt_number", "student_id", "amount_paid", "payment_method"]
    },
    "discipline_incidents": {
      "title": "Discipline Incidents",
      "description": "Student disciplinary logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "school_id": { "type": "string" },
        "student_id": { "type": "string" },
        "student_name": { "type": "string" },
        "class_name": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "description": { "type": "string" },
        "action_taken": { "type": "string" },
        "recorded_by_name": { "type": "string" },
        "term": { "type": "string" },
        "parent_notified": { "type": "boolean" }
      },
      "required": ["id", "school_id", "student_id", "date", "category", "severity"]
    },
    "books": {
