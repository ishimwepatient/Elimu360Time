{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User accounts for teachers and educators using Elimu360 Open System.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photo_url": { "type": "string" },
        "school_name": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "lesson_plans": {
      "title": "Lesson Plans",
      "description": "AI-generated and customized competency-based lesson plans.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "school_name": { "type": "string" },
        "teacher_name": { "type": "string" },
        "term": { "type": "string" },
        "date": { "type": "string" },
        "subject": { "type": "string" },
        "class_level": { "type": "string" },
        "unit_number": { "type": "string" },
        "lesson_number": { "type": "string" },
        "duration": { "type": "string" },
        "class_size": { "type": "number" },
        "special_needs": { "type": "string" },
        "unit_title": { "type": "string" },
        "key_unit_competence": { "type": "string" },
        "lesson_title": { "type": "string" },
        "instructional_objective": { "type": "string" },
        "location": { "type": "string" },
        "learning_materials": { "type": "string" },
        "references": { "type": "string" },
        "activity_summary": { "type": "string" },
        "self_evaluation": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "subject", "class_level", "unit_title", "lesson_title"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "User account documents."
    },
    "lesson_plans/{planId}": {
      "schema": "lesson_plans",
      "description": "Saved lesson plans collection."
    }
  }
}
